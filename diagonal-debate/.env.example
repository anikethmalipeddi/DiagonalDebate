# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Authentication (generate with: openssl rand -base64 32)
JWT_SECRET="replace-with-at-least-32-random-characters"

# Comma-separated emails with admin access. Admins also receive legislation.
ADMIN_EMAILS="new.leader@example.com,coach@example.com"

# AI features
GEMINI_API_KEY=""

# Rate limiting (optional locally; strongly recommended in production)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Email
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="team@example.com"
SMTP_PASS="app-password"
SMTP_FROM="DiagonalDebate <team@example.com>"
CONTACT_EMAIL="team@example.com"
